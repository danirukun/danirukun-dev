---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCollection from '../components/ProjectCollection.svelte';

import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

import { sanityClient } from "sanity:client";
import type { Project } from "../types";

const projects = await sanityClient.fetch(`*[_type == "project"] | order(_createdAt desc)`) as Project[];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header title={SITE_TITLE} />
		<main class="mx-auto max-w-7xl">
			<header class="px-4 py-12 text-center sm:px-6 lg:px-8">
				<h1 class="mb-4 text-5xl font-bold tracking-tight text-foreground sm:text-6xl">
					Portfolio
				</h1>
				<p class="mx-auto max-w-2xl text-lg text-muted-foreground sm:text-xl">
					Here you will find past and current projects I work on.
				</p>
			</header>
			<ProjectCollection projects={projects} />
		</main>
		<Footer />
	</body>
</html>
