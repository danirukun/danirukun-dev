---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import BlogFilter from '../../components/BlogFilter.svelte';

import placeholderImg from '../../images/blog-index-placeholder.png';
import type { SanityDocument } from 'sanity';
import { loadQuery } from '../../sanity/lib/load-query';
import { urlForImage } from '../../sanity/lib/urlForImage';

const { data: posts } = await loadQuery<SanityDocument[]>({
	query: `*[_type == "post"] | order(_updatedAt desc) {
		...,
		categories[]->
	}`,
});

const allCategories = Array.from(
	new Set(
		posts
			.flatMap((post) => post.categories || [])
			.map((cat: { title: string }) => cat.title)
	)
).sort();

const postsWithImageUrls = posts.map((post) => ({
	...post,
	imageUrl: post.mainImage ? urlForImage(post.mainImage).url() : placeholderImg.src,
	imageAlt: post.mainImage?.alt || post.title || "",
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="mx-auto max-w-7xl">
			<header class="px-4 py-12 text-center sm:px-6 lg:px-8">
				<p class="mx-auto max-w-2xl text-lg text-muted-foreground sm:text-xl">
					I write about tech and life things.
				</p>
			</header>
			<section id="blog-index" class="px-4 pb-12 sm:px-6 lg:px-8">
				<BlogFilter 
					client:load
					posts={postsWithImageUrls} 
					categories={allCategories}
				/>
			</section>
		</main>
		<Footer />
	</body>
</html>
