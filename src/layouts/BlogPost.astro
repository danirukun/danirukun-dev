---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { urlForImage } from '../sanity/lib/urlForImage';
import FormattedDate from '../components/FormattedDate.astro';

const { title, description, updatedDate, heroImage, categories, _updatedAt } = Astro.props;

const heroImageUrl = heroImage?.asset ? urlForImage(heroImage.asset).url() : heroImage;
const heroImageAlt = heroImage?.alt || title || "Hero image";
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.blog-content {
				@apply text-foreground;
			}
			.blog-content :global(h1),
			.blog-content :global(h2),
			.blog-content :global(h3),
			.blog-content :global(h4),
			.blog-content :global(h5),
			.blog-content :global(h6) {
				@apply font-semibold tracking-tight text-foreground mt-8 mb-4;
			}
			.blog-content :global(h1) {
				@apply text-4xl;
			}
			.blog-content :global(h2) {
				@apply text-3xl;
			}
			.blog-content :global(h3) {
				@apply text-2xl;
			}
			.blog-content :global(h4) {
				@apply text-xl;
			}
			.blog-content :global(p) {
				@apply leading-relaxed mb-6;
			}
			.blog-content :global(a) {
				@apply text-primary no-underline hover:underline;
			}
			.blog-content :global(strong) {
				@apply font-semibold text-foreground;
			}
			.blog-content :global(code) {
				@apply bg-muted px-1.5 py-0.5 rounded text-sm font-mono text-foreground;
			}
			.blog-content :global(pre) {
				@apply bg-muted p-4 rounded-lg overflow-x-auto mb-6;
			}
			.blog-content :global(pre code) {
				@apply bg-transparent p-0;
			}
			.blog-content :global(blockquote) {
				@apply border-l-4 border-l-primary pl-4 italic my-6 text-muted-foreground;
			}
			.blog-content :global(ul),
			.blog-content :global(ol) {
				@apply my-6 ml-6;
			}
			.blog-content :global(ul) {
				@apply list-disc;
			}
			.blog-content :global(ol) {
				@apply list-decimal;
			}
			.blog-content :global(li) {
				@apply mb-2;
			}
			.blog-content :global(img) {
				@apply rounded-lg shadow-md my-8 w-full;
			}
			.blog-content :global(hr) {
				@apply my-8 border-border;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImageUrl && (
					<div class="relative w-full overflow-hidden bg-muted">
						<div class="aspect-video w-full">
							<img
								class="h-full w-full object-cover"
								src={heroImageUrl}
								alt={heroImageAlt}
							/>
						</div>
					</div>
				)}
				<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
					<header class="mb-8 space-y-4 border-b border-border pb-8">
						<h1 class="text-4xl font-bold tracking-tight text-foreground sm:text-5xl lg:text-6xl">
							{title}
						</h1>
						{description && (
							<p class="text-lg text-muted-foreground sm:text-xl">
								{description}
							</p>
						)}
						<div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground">
							{_updatedAt && (
								<time datetime={new Date(_updatedAt).toISOString()}>
									<FormattedDate date={new Date(_updatedAt)} />
								</time>
							)}
							{updatedDate && _updatedAt && new Date(updatedDate).getTime() !== new Date(_updatedAt).getTime() && (
								<span class="text-xs italic">
									Updated <FormattedDate date={new Date(updatedDate)} />
								</span>
							)}
							{categories && categories.length > 0 && (
								<div class="flex flex-wrap gap-2">
									{categories.map((category: { title: string }) => (
										<span class="inline-flex items-center rounded-full border border-border bg-secondary px-3 py-1 text-xs font-semibold text-secondary-foreground transition-colors hover:bg-secondary/80">
											{category.title}
										</span>
									))}
								</div>
							)}
						</div>
					</header>
					<div class="blog-content">
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
